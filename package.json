{
  "name": "@launchastro/work-map",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Local, read-only work maps driven by each project’s roadmap config",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "dev": "vite",
    "build": "vite build",
    "generate:github": "node src/cli/generate.ts github",
    "generate:agents": "node src/cli/generate.ts agents",
    "generate:snapshot": "node src/cli/generate.ts snapshot",
    "serve": "node src/cli/serve.ts"
  },
  "dependencies": {
    "@fontsource-variable/chivo-mono": "5.3.0",
    "@fontsource-variable/funnel-sans": "5.3.0",
    "@fontsource/funnel-display": "5.3.0",
    "marked": "18.0.3",
    "parse5": "8.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "28.1.0",
    "oxlint": "1.81.0",
    "playwright": "^1.63.0",
    "prettier": "3.9.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
